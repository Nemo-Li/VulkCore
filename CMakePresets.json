{
    "version": 5,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 24,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "windows",
            "displayName": "Windows x64 (Visual Studio 2022)",
            "generator": "Visual Studio 17 2022",
            "architecture": "x64",
            "binaryDir": "${sourceDir}/build/windows",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            },
            "cacheVariables": {
                "CMAKE_CONFIGURATION_TYPES": "Debug;Release",
                "CMAKE_VS_GLOBALS": "VcpkgEnabled=false",
                "BUILD_SHARED_LIBS": "OFF",
                "BUILD_TESTING": "ON"
            }
        },
        {
            "name": "macOS",
            "displayName": "macOS (Apple Clang, Debug)",
            "generator": "Unix Makefiles",
            "binaryDir": "${sourceDir}/build",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Darwin"
            },
            "cacheVariables": {
                "CMAKE_C_COMPILER": "/usr/bin/clang",
                "CMAKE_CXX_COMPILER": "/usr/bin/clang++",
                "CMAKE_BUILD_TYPE": "Debug"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "windows-release",
            "configurePreset": "windows",
            "configuration": "Release"
        },
        {
            "name": "windows-debug",
            "configurePreset": "windows",
            "configuration": "Debug"
        },
        {
            "name": "macos-debug",
            "configurePreset": "macOS",
            "targets": ["VulkCore"]
        }
    ],
    "testPresets": [
        {
            "name": "windows-release",
            "configurePreset": "windows",
            "configuration": "Release",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "windows-debug",
            "configurePreset": "windows",
            "configuration": "Debug",
            "output": {
                "outputOnFailure": true
            }
        }
    ]
}